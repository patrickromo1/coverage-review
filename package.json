{
  "name": "coverage-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "bin": {
    "coverage-review": "dist/cli/main.js",
    "coverage-review-github": "dist/github/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/main.ts",
    "eval:offline": "tsx src/evals/main.ts --offline",
    "eval:live": "tsx src/evals/main.ts --live",
    "github": "tsx src/github/main.ts",
    "action:smoke": "vitest run tests/integration/github-action.test.ts"
  },
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "openai": "^7.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
